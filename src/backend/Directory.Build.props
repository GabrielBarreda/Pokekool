<Project>

  <!--
    Propriétés MSBuild partagées par TOUS les projets sous src/backend/.
    Source unique de vérité pour TargetFramework, Nullable, langue, warnings.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors> <!-- Missing XML doc -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Deterministic>true</Deterministic>
    <Company>Pokekool</Company>
    <Product>Pokekool</Product>
    <Copyright>Copyright © 2026 Pokekool</Copyright>
    <Authors>Pokekool</Authors>
  </PropertyGroup>

  <!-- Versions centralisées des dépendances communes -->
  <PropertyGroup>
    <MicrosoftExtensionsVersion>8.0.0</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsOptionsConfigVersion>9.0.0</MicrosoftExtensionsOptionsConfigVersion>
    <EfCoreVersion>8.0.10</EfCoreVersion>
    <NpgsqlEfCoreVersion>8.0.10</NpgsqlEfCoreVersion>
    <SerilogAspNetCoreVersion>8.0.3</SerilogAspNetCoreVersion>
    <MediatRVersion>12.4.1</MediatRVersion>
    <FluentValidationVersion>11.10.0</FluentValidationVersion>
    <SwashbuckleVersion>6.8.1</SwashbuckleVersion>
    <StackExchangeRedisVersion>2.8.16</StackExchangeRedisVersion>
  </PropertyGroup>

</Project>
