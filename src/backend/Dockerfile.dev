# Dockerfile de développement — SDK .NET + dotnet watch (hot-reload)
# Pas de build multi-stage, pas de publish Release (le code source est monté en volume
# → les changements sont détectés en ~2s).
# Blender headless EST installé ici (même version que le Dockerfile prod) : le pipeline
# .blend → .glb (module Stockage Physique / Présentoir 3D) doit pouvoir être testé en dev.

FROM mcr.microsoft.com/dotnet/sdk:8.0

# Version de Blender — doit rester synchronisée avec src/backend/Dockerfile (prod).
ARG BLENDER_VERSION=5.1.2
ARG BLENDER_MAJOR=5.1

# Dépendances système pour Playwright/Chromium (scraping) + Blender headless
RUN apt-get update && apt-get install -y --no-install-recommends \
        libnss3 libnspr4 libdbus-1-3 \
        libatk1.0-0 libatk-bridge2.0-0 \
        libcups2 libdrm2 libxkbcommon0 \
        libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
        libgbm1 libasound2 \
        wget xz-utils ca-certificates \
        libgl1 libegl1 libxi6 libxxf86vm1 libxrender1 \
        libxinerama1 libxcursor1 libsm6 libice6 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Téléchargement + installation de Blender dans /opt, lien dans le PATH.
RUN wget -q "https://download.blender.org/release/Blender${BLENDER_MAJOR}/blender-${BLENDER_VERSION}-linux-x64.tar.xz" \
        -O /tmp/blender.tar.xz \
    && mkdir -p /opt/blender \
    && tar -xf /tmp/blender.tar.xz -C /opt/blender --strip-components=1 \
    && ln -s /opt/blender/blender /usr/local/bin/blender \
    && rm /tmp/blender.tar.xz \
    && blender --background --version

WORKDIR /src

# dotnet watch surveille les changements de fichiers.
# Sur Windows/WSL2, l'inotify ne se propage pas bien → on force le polling.
ENV DOTNET_USE_POLLING_FILE_WATCHER=1 \
    ASPNETCORE_ENVIRONMENT=Development \
    ASPNETCORE_HTTP_PORTS=8080

EXPOSE 8080

# Le source code arrive via le volume mount dans docker-compose.dev.yml.
# dotnet restore est lancé au démarrage (résultats mis en cache dans le volume nuget).
ENTRYPOINT ["dotnet", "watch", "run", \
            "--project", "Pokekool.API/Pokekool.API.csproj", \
            "--urls", "http://0.0.0.0:8080"]
