<?xml version="1.0" encoding="UTF-8"?>
<Application
    x:Class="Pokekool.Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:Pokekool.Mobile.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
            <conv:FirstNotEmptyConverter x:Key="FirstNotEmptyConverter" />
            <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
            <ResourceDictionary.MergedDictionaries>
                <!-- Généré par design-system/export-maui.js (npm run tokens:maui) -->
                <ResourceDictionary Source="Resources/Styles/Tokens.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
