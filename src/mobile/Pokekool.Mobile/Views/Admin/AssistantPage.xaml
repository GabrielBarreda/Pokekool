<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Admin.AssistantPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    x:DataType="vm:AssistantViewModel"
    Title="Assistant IA">

    <Grid RowDefinitions="*,Auto,Auto" Padding="12" RowSpacing="8">

        <CollectionView Grid.Row="0" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageItem">
                    <Grid Padding="0,4">
                        <Border Padding="12,8" StrokeThickness="0" MaximumWidthRequest="300"
                                BackgroundColor="{StaticResource ColorNeutral200}"
                                StrokeShape="RoundRectangle 14"
                                HorizontalOptions="Start">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource ColorBrandPrimary}" />
                                    <Setter Property="HorizontalOptions" Value="End" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Text}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource ColorBrandOnPrimary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" Margin="0,40">
                    <Label Text="🤖" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="Posez une question à l'assistant boutique (stock, prix, RDV…)."
                           HorizontalOptions="Center" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Action en attente de confirmation -->
        <Border Grid.Row="1" Style="{StaticResource Card}"
                IsVisible="{Binding PendingAction, Converter={StaticResource IsNotNullConverter}}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding PendingAction.Summary}" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="Confirmer" Command="{Binding ConfirmActionCommand}" />
                    <Button Grid.Column="1" Text="Ignorer" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DismissActionCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Placeholder="Votre message…" Text="{Binding Input}"
                   ReturnType="Send" ReturnCommand="{Binding SendCommand}" />
            <Button Grid.Column="1" Text="➤" WidthRequest="52" Command="{Binding SendCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
        </Grid>
    </Grid>
</ContentPage>
