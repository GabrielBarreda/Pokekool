<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Admin.PresentoirPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    xmlns:dto="clr-namespace:Pokekool.Shared.Dtos.Shop;assembly=Pokekool.Shared"
    x:DataType="vm:PresentoirViewModel"
    Title="Présentoir">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <SearchBar Grid.Row="0" Placeholder="Rechercher un produit…" Text="{Binding Search}"
                   SearchCommand="{Binding RefreshCommand}" />
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorSemanticDanger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Products}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ShopProductDto">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="{Binding CardImage}" HeightRequest="72" Aspect="AspectFit" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label FontAttributes="Bold" LineBreakMode="TailTruncation">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource FirstNotEmptyConverter}">
                                                <Binding Path="CardName" />
                                                <Binding Path="ProductName" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Style="{StaticResource SubtleLabel}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1:N2} {2} · qté {3}">
                                                <Binding Path="Type" />
                                                <Binding Path="Price" />
                                                <Binding Path="Currency" />
                                                <Binding Path="Quantity" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                                    <Label Text="En vente" FontSize="11" HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource ColorSemanticSuccess}"
                                           IsVisible="{Binding IsAvailable}" />
                                    <Label Text="Retiré" FontSize="11" HorizontalTextAlignment="Center"
                                           TextColor="{StaticResource ColorNeutral500}"
                                           IsVisible="{Binding IsAvailable, Converter={StaticResource InvertBoolConverter}}" />
                                    <Button Text="Basculer" Style="{StaticResource SecondaryButton}"
                                            HeightRequest="32" FontSize="12" Padding="10,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresentoirViewModel}}, Path=ToggleAvailabilityCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Aucun produit." HorizontalOptions="Center" Margin="0,40"
                           Style="{StaticResource SubtleLabel}" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
