<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Admin.ProvidersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    x:DataType="vm:ProvidersViewModel"
    Title="Providers">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">

        <Picker Grid.Row="0" Title="Provider" ItemsSource="{Binding Providers}"
                SelectedItem="{Binding SelectedProvider}" />

        <Label Grid.Row="1" Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorSemanticDanger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Settings}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProviderSettingRow">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Key}" FontAttributes="Bold" />
                                    <Label Text="{Binding MaskedValue}" Style="{StaticResource SubtleLabel}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Modifier" Style="{StaticResource SecondaryButton}"
                                        HeightRequest="34" FontSize="12" Padding="10,0" VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProvidersViewModel}}, Path=EditSettingCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Aucune clé configurée pour ce provider." HorizontalOptions="Center" Margin="0,40"
                           Style="{StaticResource SubtleLabel}" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
