<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Admin.RolesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    x:DataType="vm:RolesViewModel"
    Title="Rôles &amp; permissions">

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="8">
        <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorSemanticDanger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Roles}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoleItem">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="système" FontSize="11"
                                           TextColor="{StaticResource ColorSemanticInfo}"
                                           IsVisible="{Binding IsSystem}" />
                                </Grid>
                                <Label Text="{Binding Code}" Style="{StaticResource SubtleLabel}" />
                                <Label Text="{Binding Details}" Style="{StaticResource SubtleLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
