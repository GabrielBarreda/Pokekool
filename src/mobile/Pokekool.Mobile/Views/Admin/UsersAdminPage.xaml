<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Admin.UsersAdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    xmlns:dto="clr-namespace:Pokekool.Shared.Dtos.Users;assembly=Pokekool.Shared"
    x:DataType="vm:UsersAdminViewModel"
    Title="Utilisateurs">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <SearchBar Grid.Row="0" Placeholder="Rechercher un utilisateur…" Text="{Binding Search}"
                   SearchCommand="{Binding RefreshCommand}" />
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorSemanticDanger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Users}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:UserSummaryDto">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Email}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource SubtleLabel}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="FirstName" />
                                                <Binding Path="LastName" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="Actif" FontSize="12" TextColor="{StaticResource ColorSemanticSuccess}"
                                           HorizontalTextAlignment="End" IsVisible="{Binding IsActive}" />
                                    <Label Text="Inactif" FontSize="12" TextColor="{StaticResource ColorSemanticDanger}"
                                           HorizontalTextAlignment="End"
                                           IsVisible="{Binding IsActive, Converter={StaticResource InvertBoolConverter}}" />
                                    <Button Text="Basculer" Style="{StaticResource SecondaryButton}" HeightRequest="32"
                                            FontSize="12" Padding="10,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersAdminViewModel}}, Path=ToggleActiveCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
