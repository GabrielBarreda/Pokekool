<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Admin.BoursePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    xmlns:dto="clr-namespace:Pokekool.Shared.Dtos.Pokemon;assembly=Pokekool.Shared"
    x:DataType="vm:BourseViewModel"
    Title="Bourse">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">

        <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorSemanticDanger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

        <!-- Séries (horizontal) -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Series}" HeightRequest="52"
                        ItemsLayout="HorizontalList" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:PokemonSeriesDto">
                    <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,8,0">
                        <Label Text="{Binding Name}" VerticalOptions="Center" FontSize="14" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BourseViewModel}}, Path=SelectSeriesCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Sets de la série sélectionnée -->
        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Sets}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PokemonSetDto">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="{Binding SymbolUrl}" HeightRequest="36" Aspect="AspectFit" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding ReleaseDate, StringFormat='Sorti le {0:d}'}"
                                           Style="{StaticResource SubtleLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding CardCount, StringFormat='{0} cartes'}"
                                       VerticalOptions="Center" Style="{StaticResource SubtleLabel}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BourseViewModel}}, Path=OpenSetCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Choisissez une série ci-dessus." HorizontalOptions="Center" Margin="0,40"
                           Style="{StaticResource SubtleLabel}" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
