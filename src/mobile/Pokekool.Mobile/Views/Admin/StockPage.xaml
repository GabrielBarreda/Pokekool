<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Admin.StockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    xmlns:dto="clr-namespace:Pokekool.Shared.Dtos.Shop;assembly=Pokekool.Shared"
    x:DataType="vm:StockViewModel"
    Title="Stock">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <SearchBar Grid.Row="0" Placeholder="Rechercher dans le stock…" Text="{Binding Search}"
                   SearchCommand="{Binding RefreshCommand}" />
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorSemanticDanger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

        <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ShopStockDto">
                        <Border Style="{StaticResource Card}" Margin="0,4">
                            <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="{Binding CardImage}" HeightRequest="72" Aspect="AspectFit" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label FontAttributes="Bold" LineBreakMode="TailTruncation">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource FirstNotEmptyConverter}">
                                                <Binding Path="CardName" />
                                                <Binding Path="ProductName" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Style="{StaticResource SubtleLabel}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="Type" />
                                                <Binding Path="Condition" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding QuantityAvailable, StringFormat='{0} dispo'}"
                                           FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding QuantityReserved, StringFormat='{0} réservé(s)'}"
                                           Style="{StaticResource SubtleLabel}" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Stock vide." HorizontalOptions="Center" Margin="0,40"
                           Style="{StaticResource SubtleLabel}" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
