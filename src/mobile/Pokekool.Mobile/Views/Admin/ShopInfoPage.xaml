<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Admin.ShopInfoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    x:DataType="vm:ShopInfoViewModel"
    Title="Infos boutique">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorSemanticDanger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ShopInfo.Name}" Style="{StaticResource TitleLabel}" />
                    <Label Text="{Binding ShopInfo.Description}"
                           IsVisible="{Binding ShopInfo.Description, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Style="{StaticResource SubtleLabel}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}, {1} {2}">
                                <Binding Path="ShopInfo.Address" />
                                <Binding Path="ShopInfo.ZipCode" />
                                <Binding Path="ShopInfo.City" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Réseaux" FontAttributes="Bold" />
                    <Label Text="{Binding ShopInfo.InstagramUrl}" Style="{StaticResource SubtleLabel}"
                           IsVisible="{Binding ShopInfo.InstagramUrl, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding ShopInfo.TiktokUrl}" Style="{StaticResource SubtleLabel}"
                           IsVisible="{Binding ShopInfo.TiktokUrl, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="L'édition complète des infos boutique se fait sur l'interface web."
                   Style="{StaticResource SubtleLabel}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
