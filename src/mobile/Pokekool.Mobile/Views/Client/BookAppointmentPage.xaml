<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Client.BookAppointmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    xmlns:dto="clr-namespace:Pokekool.Shared.Dtos.Shop;assembly=Pokekool.Shared"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    x:DataType="vm:BookAppointmentViewModel"
    Title="Prendre RDV">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Service" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding ServiceTypes}" SelectedItem="{Binding ServiceType}" />
                    <Label Text="Date" FontAttributes="Bold" />
                    <DatePicker Date="{Binding Date}" MinimumDate="{x:Static system:DateTime.Today}" />
                    <Button Text="Voir les créneaux" Command="{Binding LoadSlotsCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorSemanticDanger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
            <Label Text="{Binding Confirmation}" TextColor="{StaticResource ColorSemanticSuccess}"
                   IsVisible="{Binding Confirmation, Converter={StaticResource IsNotNullConverter}}" />

            <CollectionView ItemsSource="{Binding Slots}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:AvailableSlotDto">
                        <Border Style="{StaticResource Card}" Padding="0" HeightRequest="42">
                            <Label Text="{Binding Time}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookAppointmentViewModel}}, Path=SelectSlotCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding SelectedSlot, Converter={StaticResource IsNotNullConverter}}">
                <VerticalStackLayout Spacing="8">
                    <Label FontAttributes="Bold">
                        <Label.Text>
                            <MultiBinding StringFormat="Créneau choisi : {0} à {1}">
                                <Binding Path="SelectedSlot.Date" />
                                <Binding Path="SelectedSlot.Time" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Editor Placeholder="Notes pour la boutique (optionnel)" Text="{Binding Notes}" HeightRequest="70" />
                    <Button Text="Réserver ce créneau" Command="{Binding BookCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
