<?xml version="1.0" encoding="UTF-8"?>
<ContentPage
    x:Class="Pokekool.Mobile.Views.Shared.ScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pokekool.Mobile.ViewModels"
    x:DataType="vm:ScanViewModel"
    Title="Scan">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="12" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0" Text="📷 Prendre une photo" Command="{Binding CaptureCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
            <Button Grid.Column="1" Text="🖼 Galerie" Style="{StaticResource SecondaryButton}"
                    Command="{Binding PickCommand}" IsEnabled="{Binding IsNotBusy}" />
        </Grid>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <VerticalStackLayout Grid.Row="2" Spacing="4">
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullConverter}}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorSemanticDanger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Matches}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ScanMatchItem">
                    <Border Style="{StaticResource Card}" Margin="0,4">
                        <Grid ColumnDefinitions="Auto,56,*" ColumnSpacing="10">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding CanSelect}" VerticalOptions="Center" />
                            <Image Grid.Column="1" Source="{Binding Image}" HeightRequest="72" Aspect="AspectFit" />
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding ConfidenceLabel}" Style="{StaticResource SubtleLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" Margin="0,40">
                    <Label Text="📇" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="Photographiez vos cartes (classeur, table…) pour les identifier."
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <Button Grid.Row="4" Text="Ajouter la sélection à ma collection"
                Command="{Binding AddSelectedCommand}"
                IsVisible="{Binding HasResults}" IsEnabled="{Binding IsNotBusy}" />
    </Grid>
</ContentPage>
