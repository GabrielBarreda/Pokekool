<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Styles globaux basés sur les design tokens (Tokens.xaml). -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorNeutral50}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorNeutral900}" />
    </Style>

    <Style TargetType="Label" x:Key="TitleLabel">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ColorNeutral900}" />
    </Style>

    <Style TargetType="Label" x:Key="SubtleLabel">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource ColorNeutral600}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorBrandPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource ColorBrandOnPrimary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorNeutral200}" />
        <Setter Property="TextColor" Value="{StaticResource ColorNeutral900}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <Style TargetType="Button" x:Key="DangerButton">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSemanticDanger}" />
        <Setter Property="TextColor" Value="{StaticResource ColorNeutral0}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource ColorNeutral900}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource ColorNeutral500}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorNeutral0}" />
    </Style>

    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorNeutral0}" />
        <Setter Property="Stroke" Value="{StaticResource ColorNeutral200}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource ColorBrandPrimary}" />
    </Style>

    <Style TargetType="TabBar">
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource ColorNeutral0}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource ColorBrandPrimary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource ColorNeutral500}" />
    </Style>

</ResourceDictionary>
